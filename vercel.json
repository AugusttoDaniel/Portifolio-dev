{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/api/markdown-home"
    }
  ]
}
